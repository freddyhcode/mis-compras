# Modo del build: development | demo | production
# - development: permite INTERNET (Metro) para web y dev build
# - demo: APK de prueba, sin red ni storage
# - production: app final, sin red ni storage
# Si falta o es inválido, se asume production (fallar cerrado).
APP_MODE=development

# Datos públicos del creador. Se incluyen en el bundle: no pongas secretos.
EXPO_PUBLIC_APP_NAME=Mis Compras
EXPO_PUBLIC_APP_CREATOR=Tu nombre
EXPO_PUBLIC_APP_CONTACT=tu@correo.cl
EXPO_PUBLIC_APP_WEBSITE=tu sitio
EXPO_PUBLIC_APP_GITHUB=https://github.com/tu-usuario
EXPO_PUBLIC_APP_SUPPORT=https://tu-enlace-de-cafe
